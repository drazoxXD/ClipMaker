{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Drazox Recorder",
	"version": "0.1.0",
	"identifier": "com.drazox.recorder",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Drazox Recorder",
				"width": 1200,
				"height": 760,
				"minWidth": 1000,
				"minHeight": 620,
				"decorations": false,
				"resizable": true,
				"center": true,
				"visible": false,
				"backgroundColor": "#141414"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
		"resources": {
			"ffmpeg/bin/*.dll": "./"
		}
	}
}
